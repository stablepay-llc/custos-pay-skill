# Claude Code / Claude Desktop — environment variables
# Append to your shell rc (~/.zshrc, ~/.bashrc, or ~/.config/fish/config.fish)
# or to <repo>/.claude/.env.local for project-scoped use.

export ANTHROPIC_BASE_URL=""
export ANTHROPIC_AUTH_TOKEN=""

